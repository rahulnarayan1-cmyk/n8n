{
  "version": "2.0",
  "engine": "NIRMAN_AI_GOVERNMENT",
  "enabled": true,

  "purpose": "Discover publicly available professional government contacts, departments, projects and procurement opportunities relevant to Nirman AI.",

  "batch_size": 10,
  "max_candidates_per_source": 20,

  "source_policy": {
    "official_domains_only": true,
    "require_official_source_url": true,
